# ── Database ────────────────────────────────────────────────────────────────
DB_USER=umbryx
DB_PASSWORD=change_me_strong_password
DB_NAME=umbryx

# ── Secrets (generate with: openssl rand -hex 32) ────────────────────────────
JWT_SECRET=change_me_run_openssl_rand_hex_32
# Generate Fernet key with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production (APP_ENV=production) — startup fails without it.
ENCRYPTION_KEY=change_me_generate_fernet_key
# Redis password — must match REDIS_PASSWORD used by the redis service
REDIS_PASSWORD=change_me_redis_pw

# ── Admin account (auto-created on first run if no users exist) ──────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password

# ── Network ──────────────────────────────────────────────────────────────────
PORT=3000
# HTTPS_PORT=3443  # uncomment + swap nginx.conf → nginx-ssl.conf in docker-compose to enable HTTPS

# ── DNS (used by the backend container for scan tool resolution) ──────────────
# Override if you need to route through an internal resolver
# DNS_SERVER_1=8.8.8.8
# DNS_SERVER_2=1.1.1.1

# ── Environment (dev | production) ───────────────────────────────────────────
# Set APP_ENV=production to enforce ENCRYPTION_KEY is explicitly provided at startup
APP_ENV=dev

# Interactive Swagger UI (/docs), ReDoc (/redoc) and the raw /openapi.json
# schema are disabled by default — they sit outside the /api/ prefix our auth
# middleware gates, so leaving them on hands an unauthenticated caller the
# full API surface (security test, 2026-09-02). Uncomment only for local
# development against your own machine; never enable on a shared/deployed
# instance.
# ENABLE_API_DOCS=true

# ── JWT session ──────────────────────────────────────────────────────────────
# How long a login session token is valid. Default 8 hours.
# JWT_EXPIRE_HOURS=8

# ── Cookie security ───────────────────────────────────────────────────────────
# Set to true when running behind HTTPS (required when APP_ENV=production)
COOKIE_SECURE=false

# ── CORS (comma-separated origins) ───────────────────────────────────────────
# Empty (default) = SAME-ORIGIN ONLY: no CORS headers are emitted and
# cross-origin browser calls are refused. The SPA is served from the same
# origin and the Vite dev server proxies /api, so this works out of the box.
# Set explicitly ONLY if a genuinely different origin must call the API
# (e.g. a separate UI host). A wildcard is never applied.
# Example: CORS_ORIGINS=https://ui.example.com
CORS_ORIGINS=

# ── Webhook HMAC — REQUIRED to enable webhooks. Without it, all webhook
#    requests must include X-Hub-Signature-256: sha256=<hmac>. Without it,
#    /api/projects/{pid}/webhook/regenerate refuses to issue a webhook token
#    at all — a token in the URL path alone (which can leak via proxy logs,
#    the Referer header, or browser history) is not sufficient
#    authentication for an endpoint that creates hosts/creds/findings.
WEBHOOK_HMAC_SECRET=change_me_run_openssl_rand_hex_32

# ── Instance-to-instance sync (optional — /api/sync/*) ────────────────────────
# HMAC key that authenticates sync events between separate Umbryx instances
# (e.g. disconnected/air-gapped engagement networks that periodically
# exchange hosts/findings/notes/loot/creds for one project). Must be the
# EXACT SAME value on every instance that syncs with another — a mismatch
# just makes every pushed event fail signature verification silently
# (logged as sync.push.rejected). Leave empty to disable: /api/sync/* then
# returns 403 "Sync is not configured". Generate with:
#   openssl rand -hex 32
SYNC_SIGNING_KEY=

# ── Worker pool (optional — tune for your attacker box) ──────────────────────
# Most queued jobs are SSH-bound (nmap, nuclei, donpapi). Defaults to 8 total
# worker slots and 3 per project. Increase if your attacker box can handle
# more concurrent outbound scans without rate-limiting the targets.
# WORKER_POOL_MAX_WORKERS=8

# TLS verification for infra provisioning outbound calls (health checks,
# link probes, docker/proxmox APIs). Default: true. Set to false ONLY for
# lab infrastructure with self-signed certificates — the C2 agent login
# POST verifies TLS unconditionally regardless of this flag.
# INFRA_TLS_VERIFY=true
# WORKER_POOL_MAX_PER_PROJECT=3

# ── Worker backend ────────────────────────────────────────────────────────────
# internal (default) — jobs run as asyncio tasks inside the API process.
# arq                — jobs are dispatched to a separate arq worker process
#                      via Redis, keeping the API responsive under heavy loads.
#                      Requires the `worker` service in docker-compose.
#                      See docker-compose.yml for the commented worker block.
# WORKER_BACKEND=arq

# ── Audit log integrity (B9-4) ───────────────────────────────────────────────
# Generate AUDIT_INTEGRITY_KEY with: openssl rand -hex 32
# When set, every timeline event gets an HMAC-SHA256 fingerprint.
# GET /api/admin/audit/verify detects tampered or deleted rows.
# All events are always mirrored to UPLOAD_ROOT/audit/timeline.jsonl (append-only).
# AUDIT_INTEGRITY_KEY=change_me_run_openssl_rand_hex_32
# AUDIT_LOG_DIR=/data/uploads/audit  # default: UPLOAD_ROOT/audit
#
# Optional audit trail forwarding to external object storage (Enterprise)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# ── Plugin module signing (optional, B9-3) ───────────────────────────────────
# Generate a signing key with:  openssl rand -hex 32
# When PLUGIN_SIGNING_KEY is set, admins can sign modules via
#   POST /api/admin/modules/sign  (returns sha256=<hmac>)
# When PLUGIN_REQUIRE_SIGNATURE=true, unsigned module uploads are rejected.
# PLUGIN_SIGNING_KEY=change_me_run_openssl_rand_hex_32
# PLUGIN_REQUIRE_SIGNATURE=false

# ── Secure deletion (B10-24) ──────────────────────────────────────────────────
# When true, file deletion (purge, loot delete, note attachment delete) uses
# `shred -uzn 3` (GNU coreutils) before unlinking — reduces forensic
# recoverability of NTDS dumps, loot archives, and uploaded artifacts.
# Requires `shred` in the container PATH (present in Debian/Ubuntu by default).
# Falls back to single-pass zero-overwrite if shred is unavailable.
# Default: false (plain unlink — same behaviour as before v0.8.x)
# SECURE_DELETE=false

# ── PgBouncer (optional, B6-4) ────────────────────────────────────────────────
# Enable the pgbouncer service in docker-compose.yml and update DATABASE_URL to
# point to pgbouncer:5432 to reduce PostgreSQL connection overhead under load.
# PGBOUNCER_POOL_SIZE=25       # server-side connections to PostgreSQL per pool
# PGBOUNCER_MAX_CLIENT_CONN=200  # max simultaneous client connections to pgbouncer

# ── CI/CD image deploy (GitLab CI, see .gitlab-ci.yml) ───────────────────────
# Set by the deploy-test-infra pipeline stage before `docker compose pull` —
# points backend/frontend at prebuilt images from the GitLab Container
# Registry instead of a local build context. Leave unset for local dev
# (docker compose build keeps working exactly as before, tagging images as
# umbryx-backend:latest / umbryx-frontend:latest).
# BACKEND_IMAGE=registry.example.com/umbryx/backend
# FRONTEND_IMAGE=registry.example.com/umbryx/frontend
# IMAGE_TAG=latest

# ── Network / deployment (see docs: Configuration reference) ────────────
# Canonical external URL (OIDC redirect_uri, workstation callbacks). Set in prod.
PUBLIC_BASE_URL=
# Gates the first-run /api/auth/setup screen with a token (recommended)
SETUP_TOKEN=
# Data directory host path mounted at /data (compose-level)
#DATA_DIR=./data

# ── Database tuning (defaults are fine for small teams) ─────────────────
#DB_HOST=db
#DB_PORT=5432
#DB_SSLMODE=require
#DATABASE_REPLICA_URL=
#DATABASE_POOL_SIZE=10
#DATABASE_MAX_OVERFLOW=20
#DATABASE_POOL_RECYCLE=1800
#DATABASE_STATEMENT_TIMEOUT=30000

# ── Auth extras ──────────────────────────────────────────────────────────
#JWT_REFRESH_EXPIRE_HOURS=24
# Reject tokens when Redis is unavailable (default true)
#JWT_BLACKLIST_FAIL_CLOSED=true

# ── Logging ──────────────────────────────────────────────────────────────
#LOG_LEVEL=INFO
#LOG_FORMAT=text

# ── Outbound ────────────────────────────────────────────────────────────
# HTTP(S) proxy for platform egress (AI, notifications, provisioning)
#OUTBOUND_PROXY=
# kubectl access for k8s deploy methods
#KUBECONFIG_PATH=
#KUBECTL_TIMEOUT=60

# ── Evidence storage ────────────────────────────────────────────────────
#EVIDENCE_BACKEND=local
#EVIDENCE_LOCAL_DIR=/data/evidence

# ── License server (EE token renewal; read in both editions) ────────────
#LICENSE_SERVER_URL=https://update.umbryx.pro
